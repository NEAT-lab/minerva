{
  "@context": [
    "https://www.w3.org/2022/wot/td/v1.1",
    { "ssn": "http://www.w3.org/ns/ssn/" }
  ],
  "@type": "ssn:System",
  "id": "urn:uuid:stt-001",
  "title": "Speech-to-Text Node",
  "description": "Generic speech-to-text inference service. Accepts OggOpus binary audio and returns transcribed text. Reference implementation uses OpenAI Whisper.",
  "version": { "instance": "0.2.0" },

  "securityDefinitions": {
    "nosec_sc": { "scheme": "nosec" }
  },
  "security": "nosec_sc",

  "actions": {
    "transcribe": {
      "title": "Speech-to-Text Transcription",
      "description": "Transcribe one OggOpus audio segment to text. Optional ISO 639-1 language hint via ?language= URI variable.",
      "input": {
        "type": "string",
        "readOnly": false,
        "writeOnly": false,
        "contentMediaType": "audio/ogg; codecs=opus",
        "description": "OggOpus binary audio of one utterance"
      },
      "output": {
        "type": "object",
        "readOnly": false,
        "writeOnly": false,
        "required": ["text"],
        "properties": {
          "text": {
            "type": "string",
            "readOnly": false,
            "writeOnly": false
          },
          "language": {
            "type": "string",
            "readOnly": false,
            "writeOnly": false,
            "description": "Detected or provided ISO 639-1 language code"
          }
        }
      },
      "uriVariables": {
        "language": {
          "type": "string",
          "description": "Optional ISO 639-1 hint (e.g. 'en', 'zh'); if omitted, model auto-detects."
        }
      },
      "safe": false,
      "idempotent": true,
      "forms": [
        {
          "op": "invokeaction",
          "href": "http://{{HOST}}:{{PORT}}/transcribe{?language}",
          "contentType": "audio/ogg; codecs=opus"
        }
      ]
    }
  },

  "links": [
    {
      "rel": "service-meta",
      "href": "http://{{HOST}}:{{PORT}}/health",
      "type": "application/json"
    }
  ]
}
